{
	"name": "meyerproductions-livevoice",
	"version": "0.4.1",
	"description": "LiveVoice Remote: Companion-Modul für LiveVoice (Audio-Import und AI-Übersetzung starten/stoppen, Status-Feedbacks) über die offizielle LiveVoice Server API v2.",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run",
		"smoke": "tsx --env-file=.env scripts/smoke.ts"
	},
	"license": "MIT",
	"author": {
		"name": "meyer.productions",
		"url": "https://meyer.productions"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meyer-productions/companion-module-livevoice.git"
	},
	"bugs": {
		"url": "https://github.com/meyer-productions/companion-module-livevoice/issues"
	},
	"homepage": "https://github.com/meyer-productions/companion-module-livevoice#readme",
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "2.1.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.1",
		"@types/node": "^22.19.17",
		"eslint": "^9.39.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"tsx": "^4.19.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.0",
		"vitest": "^3.2.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.17.0",
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
